# ========================================================
# Aquaspin Laundry Station - Environment Configuration
# ========================================================

# GEMINI_API_KEY: API key for Google Gemini API integration (optional for client mock mode)
GEMINI_API_KEY=""

# APP_URL: The base URL where the application or API is hosted
APP_URL="http://localhost:3000"

# DISABLE_HMR: Set to 'true' to disable Hot Module Replacement in constrained container environments
DISABLE_HMR="false"
